						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    {\n      \"plat_id\": 1,\n      \"quantite\": 2,\n      \"accompagnements\": [\n        {\n          \"id\": 1,\n          \"quantite\": 1\n        }\n      ],\n      \"options\": [\n        {\n          \"id\": 1,\n          \"quantite\": 1\n        }\n      ]\n    },\n    {\n      \"plat_id\": 2,\n      \"quantite\": 1,\n      \"accompagnements\": [],\n      \"options\": []\n    }\n  ],\n  \"montant_total\": 7000,\n  \"lieu\": \"Bureau principal, Abidjan\",\n  \"lat\": 5.3600,\n  \"long\": -4.0083,\n  \"consigne_cuisinier\": \"Sans piment pour le premier plat\",\n  \"consigne_livreur\": \"Appeler avant d'arriver\",\n  \"mode_paiement\": \"mobile_money\",\n  \"numero_telephone\": \"+2250123456789\"\n}"
